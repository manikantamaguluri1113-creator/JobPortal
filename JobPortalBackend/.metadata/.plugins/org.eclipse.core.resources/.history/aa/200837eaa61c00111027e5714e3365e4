    @Override
    public JobApplication applyToJob(Long jobId, Long candidateId) {

        Job job = jobRepository.findById(jobId)
                .orElseThrow(() -> new RuntimeException("Job not found"));

        Optional<JobApplication> existingOpt =
                jobApplicationRepository.findByJobIdAndCandidateId(jobId, candidateId);

        if (existingOpt.isPresent()) {

            JobApplication existing = existingOpt.get();

            if (existing.getStatus() == "APPLIED") {
                throw new RuntimeException("Already applied");
            }

            if (existing.getStatus() == "WITHDRAWN") {

                LocalDateTime sixMonthsLater =
                        existing.getAppliedAt().plusMonths(6);

                if (LocalDateTime.now().isBefore(sixMonthsLater)) {
                    throw new RuntimeException(
                            "You can reapply only after 6 months from withdrawal"
                    );
                }

                // If 6 months passed → allow reapply
                existing.setStatus("APPLIED");
                existing.setAppliedAt(LocalDateTime.now());
                return jobApplicationRepository.save(existing);
            }
        }

        JobApplication application = new JobApplication();
        application.setCandidateId(candidateId);
        application.setJob(job);
        application.setStatus("APPLIED");
        application.setAppliedAt(LocalDateTime.now());

        return jobApplicationRepository.save(application);
    }

    
    @Override
    public JobApplication withdraw(Long candidateId, Long jobId) {

        JobApplication application = jobApplicationRepository
                .findByJobIdAndCandidateId(jobId, candidateId)
                .orElseThrow(() -> new RuntimeException("Application not found"));

        if (application.getStatus() == "WITHDRAWN") {
            throw new RuntimeException("Already withdrawn");
        }

        application.setStatus("WITHDRAWN");

        return jobApplicationRepository.save(application);
    }
    
    @Override
    public List<JobApplication> getApplicationsForRecruiter(Long recruiterId) {
