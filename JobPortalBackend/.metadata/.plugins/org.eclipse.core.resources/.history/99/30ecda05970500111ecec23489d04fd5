server:
  port: 8080

spring:
  application:
    name: api-gateway

  cloud:
    gateway:
      discovery:
        locator:
          enabled: true
          lower-case-service-id: true
      routes:
        - id: user-service
          uri: lb://user-service
          predicates:
            - Path=/api/users/**

        - id: user-service
          uri: lb://user-service
          predicates:
            - Path=/api/auth/**

        - id: job-service
          uri: lb://job-service
          predicates:
            - Path=/jobs/**
        
